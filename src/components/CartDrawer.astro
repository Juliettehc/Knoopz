---
import { t, formatPrice, productPath, routes, type Lang } from '../i18n/ui';
import { loadCatalog } from '../data/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { products } = await loadCatalog();

// Kleine productlijst voor de winkelwagen in de browser. In fase 4/5 komt dit uit de database.
const catalog = products.map((p) => ({
  id: p.id,
  name: p.name[lang],
  price: formatPrice(lang, p.price),
  cents: p.price,
  url: productPath(lang, p.slug),
  status: p.status,
  img: p.images[0]?.small ?? null,
}));
const labels = {
  remove: t(lang, 'cart.remove'),
  soldOut: t(lang, 'cart.soldOut'),
  unique: t(lang, 'cart.unique'),
  total: t(lang, 'price.total'),
  locale: lang === 'nl' ? 'nl-NL' : 'en-IE',
};
---
<div class="cart-backdrop" hidden data-cart-backdrop></div>
<aside class="cart" id="cart" role="dialog" aria-modal="true" aria-labelledby="cart-title" hidden data-cart>
  <div class="cart-head">
    <h2 class="label" id="cart-title">{t(lang, 'cart.title')} (<span data-cart-count>0</span>)</h2>
    <button type="button" class="cart-x" aria-label={t(lang, 'cart.close')} data-cart-close>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 1l14 14M15 1L1 15" /></svg>
    </button>
  </div>
  <div class="cart-body">
    <p class="cart-empty muted" data-cart-empty>{t(lang, 'cart.empty')}</p>
    <ul class="cart-list" data-cart-list></ul>
  </div>
  <div class="cart-foot" data-cart-foot>
    <div class="row"><span>{t(lang, 'cart.subtotal')}</span><span data-cart-subtotal></span></div>
    <span class="muted small">{t(lang, 'cart.shippingNote')}</span>
    <a class="btn btn-dark btn-block" href={routes.checkout[lang]} data-cart-checkout>{t(lang, 'cart.checkout')}</a>
    <button type="button" class="link-line center" data-cart-close>{t(lang, 'cart.continue')}</button>
    <span class="muted small center">{t(lang, 'footer.payment')}</span>
  </div>
  <template data-cart-item>
    <li class="item">
      <a class="item-img ph ph-tile" tabindex="-1" aria-hidden="true"></a>
      <div class="item-info">
        <div class="row"><a class="item-name"></a><span class="item-price"></span></div>
        <span class="muted small item-sub"></span>
        <button type="button" class="item-remove"></button>
      </div>
    </li>
  </template>
  <script type="application/json" data-cart-catalog set:html={JSON.stringify({ catalog, labels })}></script>
</aside>

<style>
  .cart-backdrop { position: fixed; inset: 0; background: rgba(20, 20, 20, 0.4); z-index: 70; }
  .cart { position: fixed; top: 0; right: 0; bottom: 0; width: min(440px, 100%); background: var(--bg); z-index: 71; display: flex; flex-direction: column; }
  .cart[hidden], .cart-backdrop[hidden] { display: none; }
  .cart-head { display: flex; justify-content: space-between; align-items: center; height: var(--header-h); padding: 0 16px 0 28px; border-bottom: 1px solid var(--line); flex: none; }
  .cart-head h2 { margin: 0; }
  .cart-x { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; background: none; border: 0; }
  .cart-body { flex: 1 1 auto; overflow-y: auto; padding: 0 28px; }
  .cart-empty { margin: 32px 0; }
  .cart-list { list-style: none; margin: 0; padding: 0; }
  .cart-foot { padding: 24px 28px 28px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px; flex: none; }
  .row { display: flex; justify-content: space-between; gap: 12px; font-size: 15px; }
  .small { font-size: 13px; }
  .center { align-self: center; text-align: center; }
  .link-line { background: none; border: 0; border-bottom: 1px solid currentColor; }
  @media (max-width: 760px) {
    .cart-head { padding-left: 20px; }
    .cart-body, .cart-foot { padding-left: 20px; padding-right: 20px; }
  }
</style>

<style is:global>
  .cart .item { display: flex; gap: 16px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .cart .item-img { width: 88px; height: 110px; flex: none; padding: 0; }
  .cart .item-info { flex: 1 1 auto; display: flex; flex-direction: column; gap: 6px; font-size: 14px; }
  .cart .item-name { text-decoration: none; }
  .cart .item-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cart .item-sold { color: var(--accent); }
  .cart .item-remove { margin-top: auto; align-self: flex-start; background: none; border: 0; border-bottom: 1px solid var(--muted); padding: 0; font-size: 12px; color: var(--muted); min-height: 28px; }
</style>

<script>
  import { getCart, removeFromCart, onCartChange } from '../scripts/cart';
  import { fetchStatus } from '../scripts/live';

  type Item = { id: string; name: string; price: string; cents: number | null; url: string; status: string; img: string | null };
  const root = document.querySelector<HTMLElement>('[data-cart]')!;
  const backdrop = document.querySelector<HTMLElement>('[data-cart-backdrop]')!;
  const data = JSON.parse(root.querySelector('[data-cart-catalog]')!.textContent || '{}');
  const catalog = new Map<string, Item>(data.catalog.map((p: Item) => [p.id, p]));
  const labels = data.labels;
  const list = root.querySelector<HTMLUListElement>('[data-cart-list]')!;
  const tpl = root.querySelector<HTMLTemplateElement>('[data-cart-item]')!;
  let lastFocus: HTMLElement | null = null;

  const render = () => {
    const ids = getCart().filter((id) => catalog.has(id));
    document.querySelectorAll('[data-cart-count]').forEach((el) => (el.textContent = String(ids.length)));
    root.querySelector<HTMLElement>('[data-cart-empty]')!.hidden = ids.length > 0;
    root.querySelector<HTMLElement>('[data-cart-foot]')!.hidden = ids.length === 0;
    list.replaceChildren(
      ...ids.map((id) => {
        const p = catalog.get(id)!;
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const imgLink = li.querySelector<HTMLAnchorElement>('.item-img')!;
        imgLink.href = p.url;
        if (p.img) {
          const im = document.createElement('img');
          im.src = p.img;
          im.alt = '';
          im.loading = 'lazy';
          imgLink.append(im);
        }
        const name = li.querySelector<HTMLAnchorElement>('.item-name')!;
        name.href = p.url;
        name.textContent = p.name;
        li.querySelector('.item-price')!.textContent = p.price;
        const sub = li.querySelector<HTMLElement>('.item-sub')!;
        sub.textContent = p.status === 'sold' ? labels.soldOut : labels.unique;
        if (p.status === 'sold') sub.classList.add('item-sold');
        const rm = li.querySelector<HTMLButtonElement>('.item-remove')!;
        rm.textContent = labels.remove;
        rm.setAttribute('aria-label', `${labels.remove}: ${p.name}`);
        rm.addEventListener('click', () => removeFromCart(id));
        return li;
      }),
    );
    const items = ids.map((id) => catalog.get(id)!);
    const subtotal = root.querySelector<HTMLElement>('[data-cart-subtotal]')!;
    subtotal.textContent = items.some((p) => p.cents === null)
      ? labels.total
      : new Intl.NumberFormat(labels.locale, { style: 'currency', currency: 'EUR' }).format(items.reduce((s, p) => s + (p.cents || 0), 0) / 100);
  };

  const setOpen = (open: boolean) => {
    root.hidden = !open;
    backdrop.hidden = !open;
    document.body.classList.toggle('locked', open);
    document.querySelectorAll('[data-cart-open]').forEach((b) => b.setAttribute('aria-expanded', String(open)));
    if (open) {
      lastFocus = document.activeElement as HTMLElement;
      root.querySelector<HTMLButtonElement>('[data-cart-close]')?.focus();
    } else {
      lastFocus?.focus();
    }
  };

  document.querySelectorAll('[data-cart-open]').forEach((b) => b.addEventListener('click', () => setOpen(true)));
  root.querySelectorAll('[data-cart-close]').forEach((b) => b.addEventListener('click', () => setOpen(false)));
  backdrop.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !root.hidden) setOpen(false);
  });
  document.addEventListener('knoopz:open-cart', () => setOpen(true));
  onCartChange(render);
  render();

  // Live controleren of stukken in de winkelwagen intussen verkocht zijn
  const checkLive = async () => {
    const ids = getCart().filter((id) => catalog.has(id));
    if (ids.length === 0) return;
    const status = await fetchStatus(ids);
    status.forEach((s, id) => {
      const item = catalog.get(id);
      if (item) item.status = s;
    });
    render();
  };
  checkLive();
  document.querySelectorAll('[data-cart-open]').forEach((b) => b.addEventListener('click', checkLive));
</script>
