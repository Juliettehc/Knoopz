---
// Pop-up "Early access": foto, titel en tekst komen live uit het beheer (Early access -> Pop-up),
// dus aan- en uitzetten werkt meteen, zonder opnieuw publiceren.
// Wie de pop-up sluit, ziet hem pas weer als de inhoud in het beheer verandert; wie zich aanmeldt, niet meer.
// Voorbeeld vanuit het beheer: ?popup-voorbeeld toont de opgeslagen pop-up altijd, ook als hij uit staat.
import EarlyAccessForm from './EarlyAccessForm.astro';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<dialog class="eap" aria-labelledby="eap-title" data-eap data-lang={lang} autofocus>
  <div class="eap-box">
    <button type="button" class="eap-close" aria-label={t(lang, 'ea.close')} data-eap-close>✕</button>
    <div class="eap-img" data-eap-img hidden></div>
    <div class="eap-body">
      <span class="eyebrow">{t(lang, 'ea.label')}</span>
      <h2 class="h2" id="eap-title" data-eap-title></h2>
      <div class="eap-text" data-eap-text></div>
      <EarlyAccessForm lang={lang} />
    </div>
  </div>
</dialog>

<style>
  .eap { padding: 0; border: 0; background: transparent; max-width: min(860px, calc(100vw - 32px)); width: 100%; max-height: calc(100dvh - 32px); overflow: auto; color: var(--ink); }
  .eap:focus { outline: none; }
  .eap::backdrop { background: rgba(20, 20, 20, 0.55); }
  .eap-box { position: relative; display: grid; grid-template-columns: 1fr 1fr; background: var(--bg); }
  .eap-box:not(:has(.eap-img:not([hidden]))) { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; }
  .eap-img { background: var(--line); min-height: 100%; }
  .eap-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .eap-body { display: flex; flex-direction: column; gap: 16px; padding: 48px 40px 36px; }
  .eap-text { display: flex; flex-direction: column; gap: 10px; }
  .eap-text :global(p) { margin: 0; line-height: 1.6; }
  .eap-close { position: absolute; top: 8px; right: 8px; z-index: 2; width: 44px; height: 44px; border: 0; background: var(--bg); color: var(--ink); font-size: 18px; cursor: pointer; }
  /* Telefoon: compact, zodat de site erachter zichtbaar blijft */
  @media (max-width: 760px) {
    .eap { max-width: calc(100vw - 40px); }
    .eap-box { grid-template-columns: 1fr; }
    .eap-img { height: min(22vh, 180px); min-height: 0; overflow: hidden; }
    .eap-img :global(img) { object-position: center 35%; }
    .eap-body { padding: 20px 20px 18px; gap: 10px; }
    .eap-body .h2 { font-size: 28px; line-height: 1.1; }
    .eap-text :global(p) { font-size: 15px; line-height: 1.5; }
    .eap-close { width: 36px; height: 36px; font-size: 15px; top: 6px; right: 6px; }
  }
</style>

<script>
  import { SUPABASE_URL, SUPABASE_KEY, publicImageUrl } from '../lib/supabase-config';
  import { textBlocks } from '../lib/rich';

  const dlg = document.querySelector<HTMLDialogElement>('[data-eap]');
  const KEY = 'knoopz-ea-popup';
  const preview = new URLSearchParams(location.search).has('popup-voorbeeld');
  const get = (k: string) => {
    try {
      return localStorage.getItem(k);
    } catch {
      return null;
    }
  };

  async function init() {
    if (!dlg || !SUPABASE_URL || !SUPABASE_KEY || navigator.webdriver) return;
    if (get('knoopz-ea-signed') && !preview) return;
    let row: any;
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/early_access_popup?select=*&id=eq.1`, { headers: { apikey: SUPABASE_KEY } });
      if (!res.ok) return; // tabel bestaat (nog) niet: geen pop-up
      row = (await res.json())[0];
    } catch {
      return;
    }
    if (!row || (!row.enabled && !preview)) return;
    const lang = dlg.dataset.lang === 'en' ? 'en' : 'nl';
    const title = (lang === 'en' && row.title_en) || row.title_nl;
    if (!title) return;
    // Andere inhoud in het beheer = opnieuw tonen, ook aan wie hem eerder sloot
    const version = String(row.updated_at);
    if (get(KEY) === version && !preview) return;

    dlg.querySelector('[data-eap-title]')!.textContent = title;
    const text = (lang === 'en' && row.text_en) || row.text_nl || '';
    dlg.querySelector('[data-eap-text]')!.innerHTML = textBlocks(text)
      .map(({ Tag, cls, html }) => `<${Tag}${cls ? ` class="${cls}"` : ''}>${html}</${Tag}>`)
      .join('');
    if (row.image_path) {
      const box = dlg.querySelector<HTMLElement>('[data-eap-img]')!;
      const img = document.createElement('img');
      img.src = publicImageUrl(row.image_path);
      img.alt = '';
      box.append(img);
      box.hidden = false;
    }

    // In het voorbeeld niets onthouden, zodat de echte pop-up later gewoon verschijnt
    const remember = () => {
      if (preview) return;
      try {
        localStorage.setItem(KEY, version);
      } catch {}
    };
    const close = () => {
      remember();
      dlg.close();
    };
    dlg.querySelector('[data-eap-close]')!.addEventListener('click', close);
    dlg.addEventListener('cancel', remember);
    // Klik buiten het venster sluit ook
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
    window.setTimeout(() => {
      // Niet over een geopend menu of winkelwagen heen
      if (document.body.classList.contains('locked')) return;
      dlg.showModal();
    }, preview ? 300 : 1500);
  }
  init();
</script>
