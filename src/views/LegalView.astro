---
import { rich } from '../lib/rich';
// Lange tekstpagina (privacy, voorwaarden). Tekst komt uit het beheer.
// Opmaak in de tekst: "## " aan het begin van een regel = tussenkop, "- " = opsomming, "1. " = genummerde lijst (nummert vanzelf), witregel = nieuwe alinea.
import Base from '../layouts/Base.astro';
import { t, routes, type Lang, type RouteKey } from '../i18n/ui';
import { loadCatalog } from '../data/catalog';

interface Props { lang: Lang; page: RouteKey; prefix: string; fallbackTitle: string }
const { lang, page, prefix, fallbackTitle } = Astro.props;
const other: Lang = lang === 'nl' ? 'en' : 'nl';
const { texts } = await loadCatalog();
const tx = (key: string) => texts[key]?.[lang] ?? '';
const title = tx(`${prefix}_title`) || fallbackTitle;
const updated = tx(`${prefix}_updated`);
type Block = { type: 'h' | 'p' | 'ul' | 'ol'; text?: string; items?: string[] };
const blocks: Block[] = [];
for (const chunk of tx(`${prefix}_text`).split(/\n\s*\n/)) {
  const lines = chunk.split('\n').map((l) => l.trim()).filter(Boolean);
  let para: string[] = [];
  let list: string[] = [];
  let listType: 'ul' | 'ol' = 'ul';
  const flush = () => {
    if (para.length) blocks.push({ type: 'p', text: para.join(' ') });
    if (list.length) blocks.push({ type: listType, items: list });
    para = [];
    list = [];
  };
  for (const l of lines) {
    if (l.startsWith('## ')) {
      flush();
      blocks.push({ type: 'h', text: l.slice(3) });
    } else if (/^[-•*] /.test(l) || /^\d+[.)] /.test(l)) {
      const type = /^\d/.test(l) ? 'ol' : 'ul';
      if (para.length || (list.length && type !== listType)) flush();
      listType = type;
      list.push(l.replace(/^([-•*]|\d+[.)]) /, ''));
    } else {
      if (list.length) flush();
      para.push(l);
    }
  }
  flush();
}
---
<Base lang={lang} title={title} alternate={routes[page][other]}>
  <article class="wrap section lg">
    <h1 class="h2">{title}</h1>
    {updated && <p class="muted lg-date">{updated}</p>}
    {blocks.length ? (
      blocks.map((b) =>
        b.type === 'h' ? <h2 class="h3" set:html={rich(b.text)} /> : b.type === 'ul' ? <ul>{b.items!.map((i) => <li set:html={rich(i)} />)}</ul> : b.type === 'ol' ? <ol>{b.items!.map((i) => <li set:html={rich(i)} />)}</ol> : <p set:html={rich(b.text)} />,
      )
    ) : (
      <p class="lead">{t(lang, 'page.soon')}</p>
    )}
  </article>
</Base>

<style>
  .lg { max-width: 780px; display: flex; flex-direction: column; gap: 16px; }
  .lg h1 { margin-bottom: 4px; }
  .lg-date { margin: 0 0 16px; font-size: 14px; }
  .lg h2 { margin-top: 24px; font-size: clamp(22px, 2.2vw, 28px); }
  .lg p, .lg li { margin: 0; font-size: 16px; line-height: 1.75; color: var(--muted); }
  .lg ul, .lg ol { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  /* Opsommingen met een klein knoopje in KNOOPZ-rood in plaats van een stip */
  .lg ul { list-style: none; padding-left: 26px; }
  .lg ul li { position: relative; }
  .lg ul li::before { content: ''; position: absolute; left: -26px; top: 0.5em; width: 13px; height: 13px; background: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><circle cx='10' cy='10' r='9' fill='%23a61f2e'/><circle cx='10' cy='10' r='6.2' fill='none' stroke='%23fff' stroke-opacity='.35' stroke-width='1'/><circle cx='7.6' cy='7.6' r='1.4' fill='%23fff'/><circle cx='12.4' cy='7.6' r='1.4' fill='%23fff'/><circle cx='7.6' cy='12.4' r='1.4' fill='%23fff'/><circle cx='12.4' cy='12.4' r='1.4' fill='%23fff'/></svg>") no-repeat center / contain; }
</style>
