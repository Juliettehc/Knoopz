---
// Early access-pagina. Wordt door de server getoond op /drops/<slug>/ zolang een drop niet in de gebouwde site staat
// (zie server/early-access-page.ts), en is op /early-access/ zelf een aanmeldpagina.
// Producten komen pas binnen nadat de server de code uit de link (?toegang=...) heeft gecontroleerd.
import Base from '../layouts/Base.astro';
import EarlyAccessForm from '../components/EarlyAccessForm.astro';
import { t, routes, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'nl' ? 'en' : 'nl';
const labels = {
  shop: t(lang, 'nav.shop'),
  shopHref: routes.shop[lang],
  opensOn: t(lang, 'ea.opensOn'),
  opensSoon: t(lang, 'ea.opensSoon'),
  closedText: t(lang, 'ea.closedText'),
  notFound: t(lang, 'ea.notFound'),
  signupTitle: t(lang, 'ea.signupTitle'),
  back: t(lang, 'ea.back'),
  soldOut: t(lang, 'product.soldOut'),
  add: t(lang, 'product.add'),
  inCart: t(lang, 'product.inCart'),
  unique: t(lang, 'product.unique'),
  sizeLabel: t(lang, 'product.sizeLabel'),
  sizeAdjustable: t(lang, 'product.size'),
  code: t(lang, 'product.code'),
  details: t(lang, 'product.details'),
  button: t(lang, 'product.button'),
  placeholder: t(lang, 'price.placeholder'),
  photo: lang === 'nl' ? 'Productfoto' : 'Product photo',
  error: t(lang, 'ea.errServer'),
};
---
<Base lang={lang} title={t(lang, 'ea.label')} alternate={lang === 'nl' ? '/en/early-access/' : '/early-access/'} noindex>
  <div class="ea" data-ea data-lang={lang} data-other={other} data-labels={JSON.stringify(labels)}>
    <!-- Met foto (uit de pop-up): foto links, tekst en aanmelden rechts; zonder foto alles onder elkaar -->
    <section class="wrap ea-top">
      <div class="ea-photo" data-photo hidden></div>
      <div class="ea-intro">
        <nav aria-label={lang === 'nl' ? 'Kruimelpad' : 'Breadcrumb'} class="crumbs muted" data-crumbs hidden>
          <a href={routes.home[lang]}>Home</a><span aria-hidden="true">/</span><a href={routes.shop[lang]}>{labels.shop}</a><span aria-hidden="true">/</span><span aria-current="page" data-crumb-name></span>
        </nav>
        <span class="eyebrow">{t(lang, 'ea.label')}</span>
        <h1 class="h1" data-title>{t(lang, 'ea.signupTitle')}</h1>
        <p class="lead" data-when hidden></p>
        <div class="ea-lead" data-intro><p class="lead">{t(lang, 'ea.signupText')}</p></div>
      </div>
      <div class="ea-signup" data-signup>
        <EarlyAccessForm lang={lang} />
      </div>
    </section>

    <p class="wrap muted" data-loading hidden>{t(lang, 'ea.loading')}</p>

    <section class="wrap ea-listing" data-listing hidden>
      <div class="grid" data-grid></div>
    </section>

    <section class="wrap ea-product" data-detail hidden></section>
  </div>
</Base>

<style>
  .ea-top { padding-top: var(--s5); padding-bottom: var(--s5); display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: 'text' 'form'; column-gap: var(--s5); }
  .ea-top:has(.ea-photo:not([hidden])) { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-areas: 'photo text' 'photo form'; }
  .ea-photo { grid-area: photo; aspect-ratio: 4 / 5; overflow: hidden; background: var(--line); }
  .ea-photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ea-intro { grid-area: text; align-self: end; display: flex; flex-direction: column; gap: 16px; }
  .ea-lead { display: flex; flex-direction: column; gap: 12px; }
  .ea-lead :global(p) { margin: 0; }
  .crumbs { display: flex; gap: 8px; font-size: 12px; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .ea-signup { grid-area: form; align-self: start; padding-top: var(--s4); max-width: 560px; }
  .ea-listing { padding-top: var(--s4); padding-bottom: var(--s6); }
  .ea-product { padding-top: var(--s4); padding-bottom: var(--s6); }
  /* productdetail (zelfde opbouw als de productpagina) */
  .ea :global(.p-wrap) { display: grid; grid-template-columns: 7fr 5fr; gap: var(--s5); align-items: start; }
  .ea :global(.p-photos) { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .ea :global(.p-photos .ph) { aspect-ratio: 4 / 5; padding: 0; overflow: hidden; }
  .ea :global(.p-photos .ph:first-child) { grid-column: 1 / -1; }
  .ea :global(.p-photos img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ea :global(.p-info) { position: sticky; top: calc(var(--header-h) + 24px); display: flex; flex-direction: column; gap: 24px; }
  .ea :global(.p-title) { display: flex; flex-direction: column; gap: 10px; }
  .ea :global(.p-price) { font-size: 18px; }
  .ea :global(.p-facts) { display: flex; flex-direction: column; gap: 6px; font-size: 14px; }
  .ea :global(.p-desc) { display: flex; flex-direction: column; gap: 12px; font-size: 16px; line-height: 1.7; }
  .ea :global(.p-desc p) { margin: 0; }
  .ea :global(.p-back) { font-size: 13px; }
  @media (max-width: 760px) {
    .crumbs { display: none; }
    /* Telefoon: foto klein links naast de tekst, aanmelden over de volle breedte eronder */
    .ea-top { padding-top: var(--s4); padding-bottom: var(--s4); }
    .ea-top:has(.ea-photo:not([hidden])) { grid-template-columns: 40% minmax(0, 1fr); grid-template-areas: 'photo text' 'form form'; column-gap: 16px; }
    .ea-top:has(.ea-photo:not([hidden])) .ea-intro { align-self: center; gap: 8px; }
    .ea-top:has(.ea-photo:not([hidden])) .h1 { font-size: 30px; line-height: 1.1; }
    .ea-top:has(.ea-photo:not([hidden])) .ea-lead :global(p) { font-size: 15px; line-height: 1.5; }
    .ea-signup { padding-top: var(--s3); max-width: none; }
    .ea :global(.p-wrap) { grid-template-columns: 1fr; gap: 28px; }
    .ea :global(.p-info) { position: static; }
    .ea :global(.p-photos) { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { addToCart, inCart, onCartChange } from '../scripts/cart';
  import { codeFor, rememberAccess } from '../scripts/access';
  import { SUPABASE_URL, SUPABASE_KEY, publicImageUrl } from '../lib/supabase-config';
  import { textBlocks } from '../lib/rich';

  type P = {
    id: string; code: string; slug: string; category: string; name_nl: string; name_en: string | null;
    description_nl: string | null; description_en: string | null; details_nl: string | null; details_en: string | null;
    button_story_nl: string | null; button_story_en: string | null; price_cents: number | null; size: string | null;
    available: boolean; images: { small: string; large: string; alt_nl: string | null; alt_en: string | null }[];
  };

  const root = document.querySelector<HTMLElement>('[data-ea]')!;
  const L = JSON.parse(root.dataset.labels || '{}');
  const lang = root.dataset.lang === 'en' ? 'en' : 'nl';
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const esc = (v: unknown) =>
    String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const tr = (nl: string | null | undefined, en: string | null | undefined) => (lang === 'en' && en ? en : nl ?? '');
  const blocks = (s: string | null | undefined) => textBlocks(s).map(({ Tag, cls, html }) => `<${Tag}${cls ? ` class="${cls}"` : ''}>${html}</${Tag}>`).join('');
  const price = (c: number | null) =>
    c === null ? L.placeholder : new Intl.NumberFormat(lang === 'en' ? 'en-IE' : 'nl-NL', { style: 'currency', currency: 'EUR' }).format(c / 100);

  // Welke drop? /drops/<slug>/ of /en/drops/<slug>/ (op /early-access/ zelf: alleen aanmelden)
  const slug = location.pathname.match(/^\/(?:en\/)?drops\/([a-z0-9-]+)\/?$/)?.[1] ?? null;

  // Taalwissel in menu en footer naar dezelfde drop in de andere taal laten wijzen
  if (slug) {
    const otherPath = `${lang === 'en' ? '' : '/en'}/drops/${slug}/${location.search}`;
    document.querySelectorAll<HTMLAnchorElement>('a[href="/early-access/"], a[href="/en/early-access/"]').forEach((a) => {
      const toOther = a.getAttribute('href') === (lang === 'en' ? '/early-access/' : '/en/early-access/');
      a.href = toOther ? otherPath : location.pathname + location.search;
    });
  }

  let products: P[] = [];

  const card = (p: P) => {
    const [first, second] = p.images;
    const sold = !p.available;
    return `<a class="card" href="#${esc(p.slug)}" data-status="${sold ? 'sold' : 'available'}">
      <div class="card-media ph ph-tile">
        ${first
          ? `<img class="card-img" src="${esc(publicImageUrl(first.small))}" alt="${esc(tr(first.alt_nl, first.alt_en) || tr(p.name_nl, p.name_en))}" width="800" height="1000" loading="lazy" decoding="async" />` +
            (second ? `<img class="card-img card-img-2" src="${esc(publicImageUrl(second.small))}" alt="" width="800" height="1000" loading="lazy" decoding="async" aria-hidden="true" />` : '')
          : `<span class="ph-label">[${esc(L.photo)}]</span>`}
        ${sold ? `<span class="badge">${esc(L.soldOut)}</span>` : ''}
      </div>
      <div class="card-meta"><span class="card-name">${esc(tr(p.name_nl, p.name_en))}</span><span class="muted">${esc(sold ? L.soldOut : price(p.price_cents))}</span></div>
    </a>`;
  };

  const detail = (p: P) => {
    const sold = !p.available;
    const photos = p.images.length
      ? p.images.map((i) => `<div class="ph ph-tile"><img src="${esc(publicImageUrl(i.large))}" alt="${esc(tr(i.alt_nl, i.alt_en) || tr(p.name_nl, p.name_en))}" loading="lazy" decoding="async" /></div>`).join('')
      : `<div class="ph ph-tile"><span class="ph-label">[${esc(L.photo)}]</span></div>`;
    const acc = (title: string, text: string | null) => (text ? `<details open><summary>${esc(title)}</summary>${blocks(text)}</details>` : '');
    return `<a class="p-back" href="#">← ${esc(L.back)}</a>
      <div class="p-wrap">
        <div class="p-photos">${photos}</div>
        <div class="p-info">
          <div class="p-title"><h2 class="h2">${esc(tr(p.name_nl, p.name_en))}</h2><span class="p-price">${esc(sold ? L.soldOut : price(p.price_cents))}</span></div>
          <div class="p-facts muted">
            ${sold ? '' : `<span>${esc(L.unique)}</span>`}
            <span>${esc(p.size ? `${L.sizeLabel}: ${p.size}` : L.sizeAdjustable)}</span>
            <span>${esc(L.code)}: ${esc(p.code)}</span>
          </div>
          ${sold || p.price_cents === null ? `<button type="button" class="btn btn-block" disabled>${esc(L.soldOut)}</button>` : `<button type="button" class="btn btn-dark btn-block" data-add="${esc(p.id)}">${esc(L.add)}</button>`}
          ${tr(p.description_nl, p.description_en) ? `<div class="p-desc">${blocks(tr(p.description_nl, p.description_en))}</div>` : ''}
          <div class="acc">${acc(L.details, tr(p.details_nl, p.details_en))}${acc(L.button, tr(p.button_story_nl, p.button_story_en))}</div>
        </div>
      </div>`;
  };

  const syncAdd = () =>
    root.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((btn) => {
      const has = inCart(btn.dataset.add!);
      btn.textContent = has ? L.inCart : L.add;
      btn.classList.toggle('btn-dark', !has);
      btn.classList.toggle('btn-outline', has);
    });

  // Lijst of één product, afhankelijk van #product-slug in het adres
  const show = () => {
    const p = products.find((x) => `#${x.slug}` === location.hash);
    $('[data-listing]').hidden = !!p;
    $('[data-detail]').hidden = !p;
    if (!p) return;
    $('[data-detail]').innerHTML = detail(p);
    $('[data-detail]').querySelector('[data-add]')?.addEventListener('click', () => {
      addToCart(p.id);
      document.dispatchEvent(new CustomEvent('knoopz:open-cart'));
    });
    syncAdd();
    window.scrollTo({ top: 0 });
  };

  const formatDate = (iso: string) =>
    new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'nl-NL', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Amsterdam' }).format(new Date(iso));

  // Gewone aanmeldpagina (/early-access/, bijv. gedeeld op Instagram): titel, tekst en foto van de pop-up uit het beheer
  async function loadSignupPage() {
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/early_access_popup?select=title_nl,title_en,text_nl,text_en,image_path&id=eq.1`, { headers: { apikey: SUPABASE_KEY } });
      const row = res.ok ? (await res.json())[0] : null;
      const title = row && tr(row.title_nl, row.title_en);
      if (!title) return; // nog niets ingevuld: standaardtekst blijft staan
      $('[data-title]').textContent = title;
      const text = tr(row.text_nl, row.text_en);
      if (text) $('[data-intro]').innerHTML = blocks(text).replace(/<p>/g, '<p class="lead">');
      if (row.image_path) {
        const img = document.createElement('img');
        img.src = publicImageUrl(row.image_path);
        img.alt = '';
        $('[data-photo]').append(img);
        $('[data-photo]').hidden = false;
      }
    } catch {
      /* geen verbinding: standaardtekst blijft staan */
    }
  }

  async function load() {
    if (!slug) return loadSignupPage();
    const fromLink = new URLSearchParams(location.search).get('toegang')?.trim().toLowerCase() || null;
    const code = fromLink && /^[a-z0-9-]{4,40}$/.test(fromLink) ? fromLink : codeFor(slug);
    $('[data-loading]').hidden = false;
    $('[data-signup]').hidden = true;
    let r: any;
    try {
      const res = await fetch('/api/early-access-drop', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, access: code ? [code] : [] }),
      });
      r = await res.json();
      if (!res.ok) throw new Error();
    } catch {
      $('[data-loading]').textContent = L.error;
      return;
    }
    $('[data-loading]').hidden = true;
    const name = r.drop ? tr(r.drop.name_nl, r.drop.name_en) : '';
    if (name) {
      document.title = `${name} · KNOOPZ`;
      $('[data-crumb-name]').textContent = name;
      $('[data-crumbs]').hidden = false;
    }

    if (r.state === 'open' || r.state === 'public') {
      if (code && r.state === 'open') rememberAccess(slug, code);
      products = r.products ?? [];
      $('[data-title]').textContent = name;
      $('[data-intro]').innerHTML = blocks(tr(r.drop.intro_nl, r.drop.intro_en)).replace(/<p>/g, '<p class="lead">');
      $('[data-grid]').innerHTML = products.map(card).join('');
      $('[data-listing]').hidden = false;
      window.addEventListener('hashchange', show);
      onCartChange(syncAdd);
      show();
      return;
    }

    // Nog niet open (of geen geldige code): datum + aanmelden, geen producten
    $('[data-signup]').hidden = false;
    if (r.state === 'closed') {
      $('[data-title]').textContent = name;
      const when = $('[data-when]');
      when.textContent = r.public_start ? L.opensOn.replace('{d}', formatDate(r.public_start)) : L.opensSoon;
      when.hidden = false;
      $('[data-intro]').innerHTML = `<p class="lead">${esc(L.closedText)}</p>`;
    } else {
      $('[data-title]').textContent = L.signupTitle;
      $('[data-intro]').innerHTML = `<p class="lead">${esc(L.notFound)}</p>`;
    }
  }
  load();
</script>
