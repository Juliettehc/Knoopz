---
import Base from '../layouts/Base.astro';
import { t, routes, type Lang } from '../i18n/ui';
import { loadCatalog } from '../data/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'nl' ? 'en' : 'nl';
const { site, texts } = await loadCatalog();
const tx = (key: string) => texts[key]?.[lang] ?? '';
const paras = (s: string) => s.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const title = tx('about_title') || (lang === 'nl' ? 'Over KNOOPZ' : 'About KNOOPZ');
const intro = tx('about_intro');
const blocks = [1, 2, 3]
  .map((n) => ({ title: tx(`about_${n}_title`), text: paras(tx(`about_${n}_text`)), img: site[`about_${n}`] }))
  .filter((b) => b.title || b.text.length || b.img);
const hero = site.about_hero;
const empty = !intro && blocks.length === 0 && !hero;
---
<Base lang={lang} title={title} alternate={routes.about[other]}>
  {hero && (
    <div class="ab-hero">
      <img src={hero.url} alt={hero.alt[lang]} fetchpriority="high" decoding="async" />
    </div>
  )}
  <section class="wrap section ab">
    <header class="ab-head">
      <span class="eyebrow">KNOOPZ</span>
      <h1 class="h1">{title}</h1>
      {intro ? paras(intro).map((p) => <p class="lead ab-intro">{p}</p>) : empty && <p class="lead">{t(lang, 'page.soon')}</p>}
    </header>

    {blocks.map((b, i) => (
      <div class:list={['ab-block', { 'ab-flip': i % 2 === 1, 'ab-noimg': !b.img }]}>
        {b.img && <img class="ab-img" src={b.img.url} alt={b.img.alt[lang]} loading="lazy" decoding="async" />}
        <div class="ab-text">
          {b.title && <h2 class="h2">{b.title}</h2>}
          {b.text.map((p) => <p>{p}</p>)}
        </div>
      </div>
    ))}

    <a class="btn btn-dark ab-cta" href={routes.shop[lang]}>{t(lang, 'home.shopDrop')}</a>
  </section>
</Base>

<style>
  .ab-hero { aspect-ratio: 16 / 7; max-height: 640px; width: 100%; overflow: hidden; background: var(--surface); }
  .ab-hero img { width: 100%; height: 100%; object-fit: cover; }
  .ab { display: flex; flex-direction: column; gap: var(--s6); }
  .ab-head { display: flex; flex-direction: column; gap: 20px; max-width: 760px; }
  .ab-intro { max-width: 640px; font-size: 18px; }
  .ab-block { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s5); align-items: center; }
  .ab-flip .ab-img { order: 2; }
  .ab-noimg { grid-template-columns: minmax(0, 760px); }
  .ab-img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--surface); }
  .ab-text { display: flex; flex-direction: column; gap: 18px; max-width: 520px; }
  .ab-text p { margin: 0; font-size: 16px; line-height: 1.75; color: var(--muted); }
  .ab-cta { align-self: flex-start; }
  @media (max-width: 760px) {
    .ab-hero { aspect-ratio: 4 / 5; max-height: 70vh; }
    .ab-block { grid-template-columns: 1fr; gap: 24px; }
    .ab-flip .ab-img { order: 0; }
    .ab-cta { align-self: stretch; }
  }
</style>
