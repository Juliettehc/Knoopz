---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  alternate: string; // dezelfde pagina in de andere taal
}
const { lang, title, description, alternate } = Astro.props;
const fullTitle = title ? `${title} · KNOOPZ` : 'KNOOPZ';
const desc =
  description ??
  (lang === 'nl' ? 'KNOOPZ maakt unieke statement pieces met vintage knopen.' : 'KNOOPZ makes one-of-a-kind statement pieces with vintage buttons.');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <!-- Testversie: niet laten indexeren door zoekmachines tot de lancering (fase 7) -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang={lang === 'nl' ? 'en' : 'nl'} href={alternate} />
    <meta name="theme-color" content="#F6F3EE" />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'nl' ? 'Naar de inhoud' : 'Skip to content'}</a>
    <Header lang={lang} alternate={alternate} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} alternate={alternate} />
    <CartDrawer lang={lang} />
    <script>
      import { refreshLiveStatus } from '../scripts/live';
      refreshLiveStatus();
    </script>
  </body>
</html>
