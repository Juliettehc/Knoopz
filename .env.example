# Kopieer naar .env (niet committen) en vul in.
# Dit zijn openbare waarden (publishable key), geen geheimen.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Lokaal zonder database werken:
# KNOOPZ_SAMPLE_DATA=1

# Serverfuncties (afrekenen). Deze GEHEIMEN zet je ALLEEN in Cloudflare
# (Settings -> Variables and secrets, type "Secret"), nooit in dit bestand of de repo:
#   SUPABASE_SECRET_KEY   Supabase secret key (sb_secret_...)
#   MOLLIE_API_KEY        test_... om te testen, live_... bij de lancering
#   RESEND_API_KEY        voor e-mails (zodra het domein er is)
# Gewone tekst (type "Text"):
#   MAIL_FROM             bijv. KNOOPZ <bestellingen@knoopz.nl>
#   MAIL_REPLY_TO         bijv. info@knoopz.nl
#   POSTNL_CUSTOMER_CODE   bijv. DEVC
#   POSTNL_CUSTOMER_NUMBER bijv. 11223344
#   POSTNL_SANDBOX         1 = testomgeving van PostNL (weghalen bij live)
# Geheimen (type "Secret"):
#   POSTNL_API_KEY         API-sleutel van PostNL
#   CRON_SECRET            willekeurige lange tekst, voor automatisch "bezorgd" controleren
